{
  "name": "dsh-remote-everywhere",
  "version": "0.1.0-alpha.2",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./runtime": "./src/runtime.js",
    "./client": "./src/client.js"
  },
  "bin": {
    "dsh-remote": "./src/cli.js"
  },
  "files": [
    "src",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@dsh-remote/core": "workspace:*",
    "@dsh-remote/protocol": "workspace:*",
    "@dsh-remote/tunnel": "workspace:*",
    "qrcode": "1.5.4",
    "@dsh-remote/ui": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2"
  }
}
