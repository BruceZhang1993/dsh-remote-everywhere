{
  "name": "dsh-remote-everywhere-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "check": "node tools/check.mjs && tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 tools/protocol-consumer.ts",
    "generate": "node tools/generate-types.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=15000 packages/*/test/*.test.js",
    "test:security": "node --test --test-concurrency=1 --test-timeout=15000 packages/core/test/security.test.js packages/protocol/test/fuzz.test.js",
    "test:fuzz-coverage": "node tools/coverage-fuzz.mjs",
    "test:interop": "node tools/interop.mjs",
    "test:tunnel": "node tools/tunnel-smoke.mjs",
    "test:package": "bash tools/package-smoke.sh",
    "test:release-candidate": "bash tools/package-smoke.sh --release-candidate",
    "remote": "node packages/cli/src/index.js"
  },
  "devDependencies": {
    "@dsh-remote/core": "workspace:*",
    "@dsh-remote/protocol": "workspace:*",
    "@dsh-remote/tunnel": "workspace:*",
    "noise-curve-ed": "2.1.0",
    "noise-handshake": "4.2.0",
    "typescript": "5.9.3"
  }
}
